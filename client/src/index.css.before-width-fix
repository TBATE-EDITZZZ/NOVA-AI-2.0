/* Cinematic ident + global interaction language */
.sound-toggle { min-width:48px; gap:5px; padding-inline:8px; font-size:8px; letter-spacing:.08em; }
.sound-toggle.is-on { color:var(--violet); border-color:color-mix(in srgb,var(--violet) 42%,var(--line)); background:color-mix(in srgb,var(--violet) 8%,transparent); }
.sound-toggle span { font-size:7px; font-weight:700; }
.route-stage { min-height:58vh; transform-origin:50% 12%; will-change:opacity,transform; }
.page-loading { gap:13px; align-content:center; justify-items:center; text-align:center; }
.page-loading strong { color:var(--ink); font-family:var(--display); font-size:clamp(18px,4vw,28px); letter-spacing:.1em; }
.page-loading > span:last-child { color:var(--subtle); font-size:9px; }
.route-loader-orbit { position:relative; width:32px; height:32px; display:grid; place-items:center; border:1px solid color-mix(in srgb,var(--violet) 45%,transparent); border-radius:50%; animation:loader-turn 1.1s linear infinite; }
.route-loader-orbit::before { content:""; position:absolute; inset:5px -4px; border:1px solid color-mix(in srgb,var(--cyan) 55%,transparent); border-radius:50%; transform:rotate(48deg) scaleY(.5); }
.route-loader-orbit i { width:5px; height:5px; border-radius:50%; background:var(--cyan); box-shadow:0 0 12px var(--cyan); }
.app-frame button:not(:disabled),.app-frame a[href],.app-frame [role="button"] { transition-property:color,background-color,border-color,box-shadow,transform,filter; transition-duration:180ms; transition-timing-function:cubic-bezier(.2,.75,.25,1); }
.app-frame button:not(:disabled):active,.app-frame a[href]:active,.app-frame [role="button"]:active { transform:translateY(1px) scale(.975); filter:brightness(1.08); }
.topic-card,.paper-row,.research-result,.live-card,.lesson-card,.lab-preview-card,.quiz-options button,.mode-option,.small-icon-action,.orbit-prompt button { transition:transform 220ms cubic-bezier(.2,.8,.2,1),box-shadow 220ms ease,border-color 220ms ease,background-color 220ms ease,color 180ms ease; }
.topic-card:hover,.paper-row:hover,.research-result:hover,.live-card:hover,.lesson-card:hover,.lab-preview-card:hover { transform:translateY(-2px); box-shadow:0 14px 32px color-mix(in srgb,var(--ink) 7%,transparent); }

.cinematic-intro { position:fixed; z-index:10000; inset:0; display:grid; place-items:center; overflow:hidden; isolation:isolate; color:#f7f6fb; background:#06070b; animation:intro-curtain-in .48s ease-out both; }
.cinematic-intro::before,.cinematic-intro::after { content:""; position:absolute; z-index:-1; inset:0; pointer-events:none; }
.cinematic-intro::before { background:radial-gradient(ellipse at 50% 54%,rgba(91,67,190,.23),transparent 43%),radial-gradient(ellipse at 16% 26%,rgba(239,53,75,.12),transparent 31%),radial-gradient(ellipse at 89% 74%,rgba(49,201,222,.11),transparent 27%); }
.cinematic-intro::after { opacity:.16; background-image:linear-gradient(rgba(197,191,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(197,191,255,.12) 1px,transparent 1px); background-size:68px 68px; mask-image:radial-gradient(ellipse at center,#000 5%,transparent 74%); }
.intro-atmosphere { position:absolute; z-index:-1; inset:0; overflow:hidden; }
.intro-grid { position:absolute; width:min(94vw,1120px); aspect-ratio:1; left:50%; top:53%; border:1px solid rgba(167,150,255,.16); border-radius:50%; transform:translate(-50%,-50%) scaleY(.56) rotate(-18deg); box-shadow:0 0 0 70px rgba(139,108,255,.025),0 0 0 140px rgba(139,108,255,.018),0 0 75px rgba(113,88,237,.11); animation:intro-orbit-breathe 7s ease-in-out infinite alternate; }
.intro-orbit { position:absolute; width:min(76vw,930px); aspect-ratio:1; left:50%; top:51%; border:1px solid rgba(116,209,223,.16); border-radius:50%; transform:translate(-50%,-50%) rotate(34deg) scaleY(.36); }
.intro-orbit-a { animation:intro-orbit-spin 22s linear infinite; }
.intro-orbit-b { width:min(59vw,720px); border-color:rgba(225,94,119,.15); transform:translate(-50%,-50%) rotate(-31deg) scaleY(.48); animation:intro-orbit-spin 30s linear infinite reverse; }
.intro-light-sweep { position:absolute; top:0; bottom:0; left:-42%; width:37%; background:linear-gradient(90deg,transparent,rgba(221,76,99,.14),rgba(174,145,255,.21),transparent); filter:blur(20px); transform:skewX(-15deg); animation:intro-light-sweep 1.7s .42s cubic-bezier(.18,.7,.2,1) both; }
.intro-particle { position:absolute; width:4px; height:4px; border-radius:50%; background:#9ee9e5; box-shadow:0 0 17px 3px rgba(97,217,226,.48); animation:intro-float 3.2s ease-in-out infinite alternate; }
.intro-particle-a { top:24%; left:18%; }.intro-particle-b { top:28%; right:17%; width:3px; height:3px; background:#ef7387; box-shadow:0 0 14px 3px rgba(239,115,135,.44); animation-delay:.7s; }.intro-particle-c { bottom:23%; left:26%; width:3px; height:3px; animation-delay:1.2s; }.intro-particle-d { right:24%; bottom:20%; background:#c4afff; box-shadow:0 0 14px 3px rgba(164,138,255,.48); animation-delay:.3s; }
.intro-content { width:min(100% - 34px,1180px); display:grid; justify-items:center; gap:0; padding:36px 0; text-align:center; }
.intro-eyebrow { display:flex; align-items:center; gap:9px; color:#b9b8c7; font-size:8px; font-weight:700; letter-spacing:.24em; opacity:0; animation:intro-rise .7s .2s ease-out forwards; }
.intro-status-dot { width:6px; height:6px; border-radius:50%; background:#77e4d7; box-shadow:0 0 12px rgba(119,228,215,.8); }
.intro-divider { color:#806bef; }
.intro-title-frame { position:relative; width:100%; display:grid; justify-items:center; margin:clamp(32px,8vh,80px) 0 21px; perspective:1100px; }
.intro-title-frame::before { content:""; position:absolute; top:50%; left:50%; width:min(84vw,1040px); height:1px; background:linear-gradient(90deg,transparent,rgba(235,90,116,.5),rgba(165,143,255,.8),rgba(98,218,224,.5),transparent); box-shadow:0 0 32px rgba(137,111,255,.56); transform:translate(-50%,-50%); animation:intro-line-grow 1.05s .22s cubic-bezier(.16,1,.3,1) both; }
.intro-title { position:relative; z-index:1; display:flex; align-items:center; justify-content:center; width:100%; margin:0; color:#fff; font-family:var(--display); font-size:clamp(25px,9vw,112px); font-weight:700; line-height:1; letter-spacing:-.075em; white-space:nowrap; text-shadow:0 0 28px rgba(171,153,255,.24),0 8px 65px rgba(0,0,0,.72); }
.intro-char { display:inline-block; opacity:0; transform:translateY(48px) rotateX(-78deg) scale(.82); filter:blur(12px); animation:intro-char-reveal .88s calc(.3s + var(--intro-index)*42ms) cubic-bezier(.16,1,.3,1) forwards; }
.intro-char-underscore { color:#73dce1; text-shadow:0 0 24px rgba(97,217,226,.55); }
.intro-index { position:absolute; z-index:2; top:calc(100% + 21px); color:#8c899d; font-size:7px; letter-spacing:.19em; opacity:0; animation:intro-rise .6s 1.35s ease-out forwards; }
.intro-index-left { left:10%; }.intro-index-right { right:10%; }
.intro-tagline { margin:0; color:#d3d0e0; font-family:var(--display); font-size:clamp(14px,2vw,19px); font-weight:400; letter-spacing:.02em; opacity:0; animation:intro-rise .7s 1.1s ease-out forwards; }
.intro-enter { min-height:45px; display:inline-flex; align-items:center; justify-content:center; gap:12px; margin-top:clamp(31px,6vh,54px); padding:0 19px; color:#fff; background:linear-gradient(110deg,#634bd2,#785fe5 58%,#525fbd); border:1px solid rgba(201,189,255,.46); border-radius:2px; box-shadow:0 8px 32px rgba(100,76,212,.27),inset 0 1px rgba(255,255,255,.2); font-size:8px; font-weight:700; letter-spacing:.16em; opacity:0; cursor:pointer; animation:intro-rise .55s 1.62s ease-out forwards; }
.intro-enter:hover { border-color:#fff; box-shadow:0 10px 40px rgba(120,95,229,.43),inset 0 1px rgba(255,255,255,.28); transform:translateY(-2px); }
.intro-enter:focus-visible { outline:2px solid #79e0e2; outline-offset:4px; }
.intro-hint { margin-top:11px; color:#77768b; font-size:7px; letter-spacing:.1em; opacity:0; animation:intro-rise .45s 1.8s ease-out forwards; }
.intro-edge-note { position:absolute; right:22px; bottom:19px; color:#77768b; font-size:7px; letter-spacing:.14em; }
.intro-edge-note span { padding-inline:5px; color:#a48eff; }
.interaction-ripple { position:fixed; z-index:10001; left:var(--ripple-x); top:var(--ripple-y); width:14px; height:14px; pointer-events:none; border:1px solid rgba(182,165,255,.65); border-radius:50%; background:radial-gradient(circle,rgba(133,111,255,.19),transparent 72%); box-shadow:0 0 21px rgba(127,105,247,.28); transform:translate(-50%,-50%) scale(.1); animation:interaction-ripple 620ms cubic-bezier(.16,1,.3,1) forwards; }

@keyframes loader-turn { to { transform:rotate(360deg); } }
@keyframes intro-curtain-in { from { opacity:0; } to { opacity:1; } }
@keyframes intro-char-reveal { 0% { opacity:0; transform:translateY(48px) rotateX(-78deg) scale(.82); filter:blur(12px); } 68% { opacity:1; } 100% { opacity:1; transform:translateY(0) rotateX(0) scale(1); filter:blur(0); } }
@keyframes intro-rise { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }
@keyframes intro-line-grow { from { opacity:0; transform:translate(-50%,-50%) scaleX(.03); } to { opacity:1; transform:translate(-50%,-50%) scaleX(1); } }
@keyframes intro-light-sweep { 0% { opacity:0; left:-42%; } 28% { opacity:1; } 100% { opacity:.38; left:110%; } }
@keyframes intro-orbit-spin { to { rotate:360deg; } }
@keyframes intro-orbit-breathe { from { opacity:.62; scale:.96 .96; } to { opacity:1; scale:1.04 1.04; } }
@keyframes intro-float { from { transform:translate3d(0,0,0); opacity:.48; } to { transform:translate3d(8px,-12px,0); opacity:1; } }
@keyframes interaction-ripple { 0% { opacity:.8; transform:translate(-50%,-50%) scale(.15); } 100% { opacity:0; transform:translate(-50%,-50%) scale(8); } }

