@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);
}

:root {
  --primary: var(--color-blue-700);
  --primary-foreground: var(--color-blue-50);
  --sidebar-primary: var(--color-blue-600);
  --sidebar-primary-foreground: var(--color-blue-50);
  --chart-1: var(--color-blue-300);
  --chart-2: var(--color-blue-500);
  --chart-3: var(--color-blue-600);
  --chart-4: var(--color-blue-700);
  --chart-5: var(--color-blue-800);
  --radius: 0.65rem;
  --background: oklch(1 0 0);
  --foreground: oklch(0.235 0.015 65);
  --card: oklch(1 0 0);
  --card-foreground: oklch(0.235 0.015 65);
  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.235 0.015 65);
  --secondary: oklch(0.98 0.001 286.375);
  --secondary-foreground: oklch(0.4 0.015 65);
  --muted: oklch(0.967 0.001 286.375);
  --muted-foreground: oklch(0.552 0.016 285.938);
  --accent: oklch(0.967 0.001 286.375);
  --accent-foreground: oklch(0.141 0.005 285.823);
  --destructive: oklch(0.577 0.245 27.325);
  --destructive-foreground: oklch(0.985 0 0);
  --border: oklch(0.92 0.004 286.32);
  --input: oklch(0.92 0.004 286.32);
  --ring: oklch(0.623 0.214 259.815);
  --sidebar: oklch(0.985 0 0);
  --sidebar-foreground: oklch(0.235 0.015 65);
  --sidebar-accent: oklch(0.967 0.001 286.375);
  --sidebar-accent-foreground: oklch(0.141 0.005 285.823);
  --sidebar-border: oklch(0.92 0.004 286.32);
  --sidebar-ring: oklch(0.623 0.214 259.815);
}

.dark {
  --primary: var(--color-blue-700);
  --primary-foreground: var(--color-blue-50);
  --sidebar-primary: var(--color-blue-500);
  --sidebar-primary-foreground: var(--color-blue-50);
  --background: oklch(0.141 0.005 285.823);
  --foreground: oklch(0.85 0.005 65);
  --card: oklch(0.21 0.006 285.885);
  --card-foreground: oklch(0.85 0.005 65);
  --popover: oklch(0.21 0.006 285.885);
  --popover-foreground: oklch(0.85 0.005 65);
  --secondary: oklch(0.24 0.006 286.033);
  --secondary-foreground: oklch(0.7 0.005 65);
  --muted: oklch(0.274 0.006 286.033);
  --muted-foreground: oklch(0.705 0.015 286.067);
  --accent: oklch(0.274 0.006 286.033);
  --accent-foreground:  oklch(0.92 0.005 65);
  --destructive: oklch(0.704 0.191 22.216);
  --destructive-foreground: oklch(0.985 0 0);
  --border: oklch(1 0 0 / 10%);
  --input: oklch(1 0 0 / 15%);
  --ring: oklch(0.488 0.243 264.376);
  --chart-1: var(--color-blue-300);
  --chart-2: var(--color-blue-500);
  --chart-3: var(--color-blue-600);
  --chart-4: var(--color-blue-700);
  --chart-5: var(--color-blue-800);
  --sidebar: oklch(0.21 0.006 285.885);
  --sidebar-foreground: oklch(0.85 0.005 65);
  --sidebar-accent: oklch(0.274 0.006 286.033);
  --sidebar-accent-foreground:  oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.488 0.243 264.376);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  button:not(:disabled),
  [role="button"]:not([aria-disabled="true"]),
  [type="button"]:not(:disabled),
  [type="submit"]:not(:disabled),
  [type="reset"]:not(:disabled),
  a[href],
  select:not(:disabled),
  input[type="checkbox"]:not(:disabled),
  input[type="radio"]:not(:disabled) {
    @apply cursor-pointer;
  }
}

@layer components {
  /**
   * Custom container utility that centers content and adds responsive padding.
   *
   * This overrides Tailwind's default container behavior to:
   * - Auto-center content (mx-auto)
   * - Add responsive horizontal padding
   * - Set max-width for large screens
   *
   * Usage: <div className="container">...</div>
   *
   * For custom widths, use max-w-* utilities directly:
   * <div className="max-w-6xl mx-auto px-4">...</div>
   */
  .container {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem; /* 16px - mobile padding */
    padding-right: 1rem;
  }

  .flex {
    min-height: 0;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .container {
      padding-left: 1.5rem; /* 24px - tablet padding */
      padding-right: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .container {
      padding-left: 2rem; /* 32px - desktop padding */
      padding-right: 2rem;
      max-width: 1280px; /* Standard content width */
    }
  }
}


/* DISCOVERY ENGINE · observatory instrument design system */
:root {
  --bg: #f3f4f8; --bg-soft: #e9ebf2; --panel: rgba(255,255,255,.78); --panel-solid: #fff;
  --line: rgba(23,26,39,.10); --line-strong: rgba(23,26,39,.18); --ink: #171923;
  --muted: #596071; --subtle: #858b9a; --violet: #7054e7; --violet-soft: #eeeaff;
  --blue: #345fc9; --cyan: #008ea6; --danger: #bd445a; --success: #268b69;
  --glow: rgba(113,83,231,.14); --shadow: 0 16px 54px rgba(34,36,57,.08);
  --content: 1180px; --header: 1450px; --radius: 5px; --display: "Space Grotesk", sans-serif; --body: "Inter", sans-serif;
  --background: #f3f4f8; --foreground: #171923; --card: #fff; --card-foreground: #171923;
  --popover: #fff; --popover-foreground: #171923; --primary: #7054e7; --primary-foreground: #fff;
  --secondary: #e9ebf2; --secondary-foreground: #414757; --muted-foreground: #697082; --accent: #eeeaff;
  --accent-foreground: #513bc1; --border: rgba(23,26,39,.12); --input: rgba(23,26,39,.16); --ring: #927cff;
}
.dark {
  color-scheme: dark; --bg: #08090e; --bg-soft: #11131b; --panel: rgba(17,19,29,.82); --panel-solid: #11131b;
  --line: rgba(224,229,255,.085); --line-strong: rgba(224,229,255,.16); --ink: #f3f3f7;
  --muted: #a1a6b6; --subtle: #777e90; --violet: #a18bff; --violet-soft: rgba(131,104,255,.13);
  --blue: #7696ff; --cyan: #61d9e2; --danger: #ff8091; --success: #6bd8b0;
  --glow: rgba(139,108,255,.17); --shadow: 0 20px 75px rgba(0,0,0,.32);
  --background: #08090e; --foreground: #f3f3f7; --card: #11131b; --card-foreground: #f3f3f7;
  --popover: #141620; --popover-foreground: #f3f3f7; --primary: #8b6cff; --primary-foreground: #fff;
  --secondary: #171923; --secondary-foreground: #c5c8d5; --muted: #1d202a; --muted-foreground: #9ba1b3;
  --accent: #242033; --accent-foreground: #c0b1ff; --border: rgba(224,229,255,.1); --input: rgba(224,229,255,.16); --ring: #a18bff;
}
html { scroll-behavior: smooth; background: var(--bg); }
html:not(.dark) { color-scheme: light; }
body { margin: 0; min-width: 320px; background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 13px; line-height: 1.65; letter-spacing: .005em; -webkit-font-smoothing: antialiased; }
body, button, input, textarea, select { font-family: var(--body); }
button, input, textarea, select { color: inherit; }
button { -webkit-tap-highlight-color: transparent; }
button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 2px solid var(--violet); outline-offset: 3px; }
a { color: inherit; }
::selection { color: #fff; background: #755be9; }
#root { min-height: 100vh; }
.app-frame { min-height: 100vh; overflow: clip; }

/* Shared shell */
.topline { height: 27px; padding: 0 max(24px, calc((100vw - var(--header))/2)); display:flex; align-items:center; justify-content:space-between; background:#07080c; color:#9b9eab; font-size:8px; letter-spacing:.14em; }
.topline > span:first-child { display:flex; gap:8px; align-items:center; }
.topline i,.status-dot { display:inline-block; width:6px; height:6px; border-radius:50%; background:#6be1d7; box-shadow:0 0 12px rgba(107,225,215,.75); }
.topline-right { color:#797d8c; }
.site-header { position:sticky; top:0; z-index:40; height:70px; display:flex; align-items:center; gap:28px; justify-content:space-between; padding:0 max(22px,calc((100vw - var(--header))/2)); background:color-mix(in srgb,var(--bg) 85%,transparent); border-bottom:1px solid var(--line); backdrop-filter:blur(18px); }
.brand-lockup { display:inline-flex; align-items:center; gap:10px; flex:0 0 auto; color:var(--ink); text-decoration:none; }
.brand-symbol { width:31px; height:31px; object-fit:contain; }
.brand-type { display:grid; gap:0; font-family:var(--display); font-size:12px; font-weight:700; letter-spacing:.11em; line-height:1.1; }
.brand-type small { margin-top:4px; color:var(--subtle); font-family:var(--body); font-size:7px; font-weight:500; letter-spacing:.16em; }
.brand-lockup-compact .brand-symbol { width:26px; height:26px; }
.primary-nav { display:flex; align-items:center; gap:3px; }
.nav-link,.nav-nova { min-height:34px; display:inline-flex; align-items:center; justify-content:center; gap:6px; padding:0 9px; color:var(--muted); font-size:9px; text-decoration:none; white-space:nowrap; border:1px solid transparent; border-radius:3px; transition:color .18s,background .18s,border-color .18s; }
.nav-link:hover,.nav-link.active { color:var(--ink); background:var(--panel); border-color:var(--line); }
.nav-nova { margin-left:7px; color:#fff; background:#7054e7; border-color:#826bf0; box-shadow:0 4px 18px rgba(112,84,231,.2); }
.dark .nav-nova { color:#fff; background:#775be7; border-color:#8d74f5; }
.nav-nova:hover,.nav-nova.active { background:#5f43d4; }
.nova-spark { color:#ddd4ff; }
.header-actions { display:flex; align-items:center; gap:8px; flex:0 0 auto; }
.icon-button,.avatar,.sign-in { min-width:34px; height:34px; display:inline-flex; align-items:center; justify-content:center; color:var(--muted); background:transparent; border:1px solid var(--line); border-radius:3px; }
.icon-button:hover,.sign-in:hover { color:var(--ink); background:var(--panel); border-color:var(--line-strong); }
.avatar { width:33px; height:33px; color:#fff; background:linear-gradient(145deg,#957bff,#563ac5); border:1px solid rgba(255,255,255,.2); border-radius:50%; font-weight:700; font-size:11px; }
.avatar-pending { background:var(--bg-soft); border-color:var(--line); }
.sign-in { gap:7px; padding:0 10px; font-size:9px; }
.menu-toggle { display:none; }
.profile-control { position:relative; }
.profile-menu { position:absolute; z-index:50; top:calc(100% + 9px); right:0; width:215px; display:grid; gap:2px; padding:7px; border:1px solid var(--line-strong); border-radius:5px; background:var(--panel-solid); box-shadow:var(--shadow); }
.profile-menu-name { overflow:hidden; padding:7px 8px 9px; color:var(--subtle); font-size:8px; text-overflow:ellipsis; white-space:nowrap; border-bottom:1px solid var(--line); }
.profile-menu > a,.profile-menu > button { display:flex; align-items:center; justify-content:space-between; gap:8px; width:100%; padding:9px 8px; color:var(--muted); background:transparent; border:0; border-radius:3px; text-decoration:none; text-align:left; font:inherit; font-size:9px; cursor:pointer; }
.profile-menu > a:hover,.profile-menu > button:hover { color:var(--ink); background:var(--bg-soft); }
.profile-menu > button { justify-content:flex-start; color:var(--danger); }
.site-footer { display:grid; grid-template-columns:1fr auto; gap:22px 40px; padding:32px max(24px,calc((100vw - var(--content))/2)) 20px; background:#07080c; color:#dedfe8; border-top:1px solid rgba(255,255,255,.1); }
.footer-brand { display:grid; gap:8px; }
.footer-brand .brand-type { color:#fff; }
.footer-brand p,.footer-note { margin:0; color:#838797; font-size:9px; }
.footer-links { display:flex; align-items:flex-start; gap:18px; flex-wrap:wrap; }
.footer-links a { color:#a8abba; font-size:9px; text-decoration:none; }
.footer-links a:hover { color:#fff; }
.footer-note { grid-column:1/-1; padding-top:13px; border-top:1px solid rgba(255,255,255,.1); letter-spacing:.08em; }
.footer-note span { color:#8b6cff; }
.page-loading { min-height:58vh; display:grid; place-items:center; color:var(--muted); font-size:11px; }

/* Editorial homepage */
.home-page { background:var(--bg); }
.hero-section { position:relative; min-height:610px; display:flex; align-items:center; isolation:isolate; overflow:hidden; background:#08090e; }
.hero-image { position:absolute; z-index:-3; inset:0; background-image:linear-gradient(90deg,rgba(6,7,12,.96) 0%,rgba(6,7,12,.89) 36%,rgba(6,7,12,.34) 76%,rgba(6,7,12,.18) 100%),linear-gradient(0deg,#08090e 0%,transparent 25%,rgba(7,8,13,.13) 100%),url('/images/cosmic-cliffs.webp'); background-position:center 44%; background-size:cover; transform:scale(1.015); animation:hero-arrive 1.3s ease-out both; }
.hero-grid { position:absolute; z-index:-2; inset:0; opacity:.18; background-image:linear-gradient(rgba(178,170,255,.1) 1px,transparent 1px),linear-gradient(90deg,rgba(178,170,255,.1) 1px,transparent 1px); background-size:64px 64px; mask-image:linear-gradient(90deg,#000,transparent 70%); }
.hero-orbit { position:absolute; z-index:-1; width:660px; height:660px; right:-100px; top:-150px; border:1px solid rgba(178,166,255,.14); border-radius:50%; transform:rotate(-20deg) scaleY(.57); box-shadow:0 0 0 65px rgba(177,162,255,.025),0 0 0 130px rgba(177,162,255,.018); }
.hero-orbit-one:before,.hero-orbit-one:after { content:""; position:absolute; border:1px solid rgba(107,225,215,.13); border-radius:50%; inset:65px -15px; transform:rotate(39deg); }
.hero-orbit-one:after { inset:126px -28px; transform:rotate(-23deg); }
.hero-copy { width:min(100% - 48px,var(--content)); margin:0 auto; padding:88px 0 110px; color:#f7f6fb; }
.eyebrow,.section-kicker,.card-kicker { display:flex; align-items:center; gap:9px; color:var(--subtle); font-size:8px; font-weight:600; letter-spacing:.15em; line-height:1.4; }
.eyebrow { color:#c4c5d1; }
.eyebrow-line { width:24px; height:1px; background:#8b6cff; box-shadow:0 0 9px #8b6cff; }
.eyebrow-index { margin-left:14px; color:#787c8b; font-variant-numeric:tabular-nums; }
.hero-copy h1 { max-width:790px; margin:27px 0 20px; font-family:var(--display); font-size:clamp(45px,7.5vw,83px); font-weight:600; letter-spacing:-.065em; line-height:.99; }
.hero-copy h1 em,.closing-banner h2 em { color:#b3a1ff; font-style:normal; }
.hero-lede { max-width:520px; margin:0 0 27px; color:#c4c6d1; font-size:14px; line-height:1.8; }
.hero-search { width:min(100%,570px); height:53px; display:flex; align-items:center; gap:13px; padding:0 7px 0 16px; background:rgba(15,16,26,.8); border:1px solid rgba(215,213,255,.24); border-radius:4px; box-shadow:0 10px 30px rgba(0,0,0,.19); backdrop-filter:blur(14px); }
.hero-search>svg { flex:0 0 auto; color:#b4a3ff; }
.hero-search input { min-width:0; flex:1; color:#f4f3fa; background:transparent; border:0; outline:none; font-size:11px; }
.hero-search input::placeholder { color:#8c91a0; }
.hero-search button { width:38px; height:38px; display:grid; place-items:center; color:#fff; background:#7658e7; border:0; border-radius:3px; }
.hero-actions { display:flex; align-items:center; gap:21px; margin-top:18px; }
.button-primary,.button-quiet,.button-outline { min-height:39px; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:0 14px; border-radius:3px; font-size:9px; font-weight:600; text-decoration:none; transition:transform .18s,background .18s,border-color .18s; }
.button-primary { color:#fff; background:#7255e6; border:1px solid #8c73f5; box-shadow:0 5px 18px rgba(112,84,231,.2); }
.button-primary:hover { background:#5e42d0; transform:translateY(-1px); }
.button-quiet { color:#d3d4de; background:transparent; border:1px solid transparent; }
.button-quiet:hover { color:#fff; border-color:rgba(255,255,255,.2); }
.button-outline { color:var(--ink); background:var(--panel); border:1px solid var(--line-strong); }
.button-outline:hover { color:var(--violet); background:var(--violet-soft); border-color:var(--violet); }
.hero-micro { display:flex; align-items:center; gap:9px; margin-top:29px; color:#a0a3b1; font-size:7px; letter-spacing:.14em; }
.micro-separator { color:#666b79; }
.hero-micro .status-dot { width:5px; height:5px; }
.hero-image-credit { position:absolute; right:max(24px,calc((100vw - var(--content))/2)); bottom:44px; display:grid; gap:4px; color:#e7e6ec; font-size:7px; letter-spacing:.1em; text-align:right; }
.hero-image-credit span { color:#b3b5c0; font-size:8px; letter-spacing:.03em; }
.hero-scroll { position:absolute; bottom:20px; left:max(24px,calc((100vw - var(--content))/2)); display:flex; align-items:center; gap:6px; color:#a5a7b3; font-size:7px; letter-spacing:.13em; text-decoration:none; }
.hero-side-label { position:absolute; top:50%; right:18px; color:#b9bac5; font-size:7px; letter-spacing:.13em; writing-mode:vertical-rl; transform:translateY(-50%); }
.signal-strip { min-height:85px; display:flex; align-items:center; justify-content:space-between; gap:18px; padding:13px max(24px,calc((100vw - var(--content))/2)); background:var(--panel-solid); border-bottom:1px solid var(--line); }
.signal-intro { display:flex; align-items:center; gap:9px; color:var(--muted); font-size:8px; letter-spacing:.12em; white-space:nowrap; }
.signal-pulse,.live-pulse { width:7px; height:7px; display:inline-block; border-radius:50%; background:var(--success); box-shadow:0 0 0 4px color-mix(in srgb,var(--success) 13%,transparent); }
.signal-item { display:grid; gap:0; min-width:120px; }
.signal-label { color:var(--subtle); font-size:7px; letter-spacing:.12em; }
.signal-item strong { color:var(--ink); font-family:var(--display); font-size:17px; font-weight:600; line-height:1.35; }
.signal-item .nova-status-word { color:var(--violet); font-size:11px; }
.signal-sub,.signal-time { color:var(--subtle); font-size:8px; }
.section-block { width:min(calc(100% - 48px),var(--content)); margin:0 auto; padding:84px 0; }
.discovery-intro { padding-top:94px; }
.section-kicker { color:var(--subtle); }
.section-kicker > span { color:var(--violet); font-family:var(--display); font-size:10px; font-weight:700; }
.intro-split { display:grid; grid-template-columns:1.15fr .85fr; align-items:end; gap:35px; margin:18px 0 40px; }
.intro-split h2,.section-heading-row h2,.nova-feature h2 { margin:0; font-family:var(--display); font-size:clamp(34px,5vw,53px); font-weight:500; letter-spacing:-.06em; line-height:1.06; }
.intro-split h2 span,.section-heading-row h2 span,.nova-feature h2 span { color:var(--violet); }
.intro-split p { max-width:420px; margin:0 0 3px; color:var(--muted); font-size:12px; line-height:1.9; }
.feature-line { display:grid; grid-template-columns:1.1fr .9fr; gap:43px; align-items:center; padding-top:8px; }
.feature-image-wrap { position:relative; overflow:hidden; aspect-ratio:1.65; background:#12131b; border:1px solid var(--line); }
.feature-image-wrap img { width:100%; height:100%; display:block; object-fit:cover; transition:transform .6s; }
.feature-image-wrap:hover img { transform:scale(1.035); }
