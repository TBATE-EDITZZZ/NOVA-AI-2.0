/* Virtual lab, simulation and experiment design */
.lab-tabs { display:flex; gap:7px; margin-bottom:15px; overflow:auto; }
.lab-tab { display:flex; align-items:center; gap:6px; }
.lab-tab:disabled { opacity:.4; cursor:not-allowed; }
.experiment-panel { padding:18px; }
.experiment-header { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; padding-bottom:15px; border-bottom:1px solid var(--line); }
.experiment-header h2 { margin:7px 0 0; font-family:var(--display); font-size:20px; font-weight:500; }
.experiment-layout { display:grid; grid-template-columns:minmax(230px,.72fr) 1.28fr; gap:20px; padding-top:18px; }
.experiment-controls { display:grid; align-content:start; gap:12px; }
.control-intro,.principle-note { color:var(--muted); font-size:9px; line-height:1.75; }
.control-index { color:var(--violet); font-size:7px; letter-spacing:.1em; }
.range-control { display:grid; grid-template-columns:1fr auto; gap:5px 8px; color:var(--ink); font-size:9px; }
.range-control input { grid-column:1/-1; width:100%; accent-color:var(--violet); }
.range-control output { color:var(--violet); font-variant-numeric:tabular-nums; }
.principle-note { padding:9px; background:var(--bg-soft); border-left:2px solid var(--violet); }
.experiment-results { min-width:0; }
.chart-topline { display:flex; align-items:center; justify-content:space-between; color:var(--subtle); font-size:8px; }
.chart-unit { color:var(--violet); }
.projectile-chart { width:100%; min-height:190px; margin-top:11px; background:linear-gradient(0deg,var(--bg-soft),transparent); border-bottom:1px solid var(--line); }
.axis-y,.axis-x { color:var(--subtle); font-size:7px; }
.result-metrics { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:12px; }
.result-metrics>div { padding:9px; background:var(--bg-soft); }
.result-metrics span { display:block; color:var(--subtle); font-size:7px; }
.result-metrics strong { display:block; margin-top:2px; color:var(--ink); font-family:var(--display); font-size:14px; font-weight:500; }
.formula-panel { margin-top:15px; padding:13px; background:var(--bg-soft); border:1px solid var(--line); }
.equation-block { color:var(--violet); font-family:var(--display); font-size:13px; }
.experiment-design { margin-top:17px; padding:18px; background:var(--panel); border:1px solid var(--line); }
.experiment-design-heading { display:flex; align-items:center; gap:9px; }
.experiment-design-heading h2 { margin:0; font-family:var(--display); font-size:16px; font-weight:500; }
.design-icon { width:30px; height:30px; display:grid; place-items:center; color:var(--violet); background:var(--violet-soft); }
.experiment-design-input { display:flex; gap:8px; margin:14px 0; }
.experiment-design-input input { min-width:0; flex:1; padding:9px 10px; color:var(--ink); background:var(--bg); border:1px solid var(--line-strong); font-size:9px; }
.experiment-design-result { margin-top:14px; padding:13px; background:var(--bg-soft); border:1px solid var(--line); }
.design-result-label { color:var(--violet); font-size:7px; font-weight:600; letter-spacing:.12em; }
.design-answer { color:var(--ink); font-size:10px; line-height:1.8; }
.next-labs { display:flex; align-items:center; gap:15px; flex-wrap:wrap; margin-top:17px; padding:12px 0; border-top:1px solid var(--line); }
.next-labs a { color:var(--violet); font-size:9px; text-decoration:none; }
.solar-system-card { overflow:hidden; background:#07080d; border:1px solid var(--line); }
.solar-system-toolbar { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:11px 14px; color:#dce0f4; border-bottom:1px solid rgba(255,255,255,.12); }
.solar-controls { display:flex; gap:6px; flex-wrap:wrap; }
.solar-controls button { padding:6px 9px; color:#c8cce0; background:#121521; border:1px solid rgba(255,255,255,.14); font-size:8px; }
.solar-controls button.selected { color:#fff; border-color:#947dff; background:rgba(130,101,255,.2); }
.solar-system-stage { position:relative; min-height:340px; }
.solar-canvas { position:absolute; inset:0; width:100%; height:100%; }
.solar-overlay,.solar-selected-label { position:absolute; top:14px; left:14px; padding:7px 9px; color:#c7c8d6; background:rgba(13,15,24,.8); border:1px solid rgba(255,255,255,.12); font-size:8px; }
.solar-selected-label { top:auto; bottom:13px; }
.solar-system-info { padding:12px; color:#c7cad7; background:#10121b; border-top:1px solid rgba(255,255,255,.1); font-size:9px; }
.planet-legend { display:flex; gap:12px; flex-wrap:wrap; padding:10px 12px; color:#aeb2c3; background:#0b0c12; font-size:7px; }
.solar-error { position:absolute; inset:auto 12px 12px; z-index:2; padding:10px; color:#ff98a5; background:#29141c; font-size:8px; }

/* Visualization, knowledge graph, library and learning */
.data-workspace { display:grid; gap:13px; }
.data-workspace-top,.dataset-toolbar { display:flex; align-items:center; justify-content:space-between; gap:10px; }
.csv-dropzone { min-height:145px; display:grid; place-items:center; align-content:center; gap:8px; padding:20px; color:var(--muted); background:var(--panel); border:1px dashed var(--line-strong); text-align:center; font-size:9px; }
.csv-dropzone:hover { border-color:var(--violet); background:var(--violet-soft); }
.dropzone-icon { color:var(--violet); }
.csv-dropzone input { max-width:230px; font-size:8px; }
.dataset-name { color:var(--ink); font-family:var(--display); font-size:12px; }
.column-selectors { display:flex; gap:8px; flex-wrap:wrap; }
.column-selectors select { min-width:140px; padding:7px; color:var(--ink); background:var(--panel-solid); border:1px solid var(--line); font-size:8px; }
.dataset-chart-head,.dataset-preview h2 { margin:0; padding:13px; color:var(--muted); border-bottom:1px solid var(--line); font-size:9px; }
.dataset-chart { min-height:250px; padding:14px; background:var(--panel); border:1px solid var(--line); }
.chart-axis-x,.chart-axis-y { color:var(--subtle); font-size:7px; }
.chart-footline { display:flex; justify-content:space-between; margin-top:8px; color:var(--subtle); font-size:7px; }
.dataset-preview { overflow:hidden; margin-top:13px; }
.table-scroll { overflow:auto; max-height:350px; }
.table-scroll table { width:100%; border-collapse:collapse; font-size:8px; }
.table-scroll th,.table-scroll td { padding:8px 10px; border-bottom:1px solid var(--line); text-align:left; white-space:nowrap; }
.table-scroll th { position:sticky; top:0; color:var(--subtle); background:var(--bg-soft); }
.correlation-note { padding:9px; border-left:2px solid var(--cyan); }
.knowledge-canvas { overflow:hidden; padding:16px; }
.knowledge-topline { display:flex; align-items:center; justify-content:space-between; gap:12px; color:var(--subtle); font-size:8px; }
.graph-scroll { overflow:auto; padding:15px 0; }
.knowledge-graph { min-width:690px; display:flex; align-items:center; justify-content:center; gap:11px; padding:48px 10px; background:radial-gradient(ellipse, color-mix(in srgb,var(--violet) 8%,transparent),transparent 68%); }
.graph-node { min-width:89px; min-height:42px; padding:8px; color:var(--ink); background:var(--panel-solid); border:1px solid var(--line-strong); border-radius:50px; font-size:8px; transition:transform .18s,box-shadow .18s; }
.graph-node:hover,.graph-node.selected { color:var(--violet); border-color:var(--violet); box-shadow:0 0 18px var(--glow); transform:translateY(-2px); }
.graph-edge { width:40px; height:1px; background:linear-gradient(90deg,var(--violet),var(--cyan)); }
.graph-legend { display:flex; gap:12px; color:var(--subtle); font-size:7px; }
.legend-dot { width:7px; height:7px; display:inline-block; margin-right:5px; border-radius:50%; }
.legend-dot.violet { background:var(--violet); }
.concept-panel { margin-top:12px; padding:15px; background:var(--bg-soft); border:1px solid var(--line); }
.concept-number { color:var(--violet); font-size:8px; letter-spacing:.1em; }
.connected-list { display:flex; gap:7px; flex-wrap:wrap; margin-top:11px; }
.connected-list span { padding:5px 8px; color:var(--muted); background:var(--panel); border:1px solid var(--line); font-size:8px; }
.library-gate { max-width:600px; margin:50px auto; padding:33px; background:var(--panel); border:1px solid var(--line); text-align:center; }
.library-gate-mark { width:55px; height:55px; display:grid; place-items:center; margin:0 auto 14px; color:var(--violet); background:var(--violet-soft); border:1px solid var(--line); border-radius:50%; }
.library-toolbar { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:13px 0; }
.danger-action { color:var(--danger); }
.library-list { display:grid; gap:10px; }
.library-record { padding:16px; }
.library-record-top { display:flex; align-items:center; justify-content:space-between; gap:10px; color:var(--subtle); font-size:7px; }
.library-record-mode { padding:3px 6px; color:var(--violet); background:var(--violet-soft); }
.library-record-date { margin-left:auto; }
.library-question { margin:11px 0; color:var(--ink); font-family:var(--display); font-size:15px; font-weight:500; }
.library-answer { color:var(--muted); font-size:9px; line-height:1.8; }
.library-answer-body { margin-top:8px; color:var(--ink); font-size:10px; }
.library-source-links { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
.library-source-links a { color:var(--violet); font-size:8px; }
.library-record-actions { display:flex; gap:6px; margin-top:12px; padding-top:10px; border-top:1px solid var(--line); }
.library-privacy-note { margin-top:12px; }
.learning-progress { display:grid; grid-template-columns:1fr auto; gap:7px; align-items:center; margin-bottom:25px; padding:16px; background:var(--panel); border:1px solid var(--line); }
.progress-track { grid-column:1/-1; height:5px; overflow:hidden; background:var(--bg-soft); }
.progress-track>span { height:100%; display:block; background:linear-gradient(90deg,var(--violet),var(--cyan)); transition:width .3s; }
.progress-foot { color:var(--subtle); font-size:8px; }
.learning-paths { display:flex; gap:7px; flex-wrap:wrap; margin:15px 0; }
.level-switcher { display:flex; gap:5px; }
.level-switcher button { padding:6px 9px; color:var(--muted); background:transparent; border:1px solid var(--line); font-size:8px; }
.level-switcher button.selected { color:var(--violet); border-color:var(--violet); background:var(--violet-soft); }
.learning-lesson-section { margin:20px 0; }
.lesson-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.lesson-card { display:flex; flex-direction:column; min-height:190px; padding:15px; background:var(--panel); border:1px solid var(--line); }
.lesson-card.completed { border-color:color-mix(in srgb,var(--success) 35%,var(--line)); }
.lesson-order { color:var(--violet); font-size:7px; letter-spacing:.12em; }
.lesson-card h3 { margin:10px 0 5px; font-family:var(--display); font-size:14px; font-weight:500; }
.lesson-card p { color:var(--muted); font-size:8px; line-height:1.7; }
.lesson-actions { display:flex; align-items:center; gap:8px; margin-top:auto; padding-top:9px; }
.lesson-complete { color:var(--success); font-size:8px; }
.lesson-ask { color:var(--violet); background:transparent; border:0; font-size:8px; }
.learning-practice-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:20px; }
.quiz-card,.flashcard-card { padding:16px; }
.quiz-card h3,.flashcard-card h3 { margin:7px 0; font-family:var(--display); font-size:16px; font-weight:500; }
.quiz-finish,.quiz-feedback { padding:9px; color:var(--success); background:color-mix(in srgb,var(--success) 9%,transparent); font-size:9px; }
.quiz-score,.quiz-counter { color:var(--subtle); font-size:8px; }
.quiz-options { display:grid; gap:6px; margin:12px 0; }
.quiz-options button { padding:8px; color:var(--muted); background:var(--bg-soft); border:1px solid var(--line); text-align:left; font-size:8px; }
.quiz-options button.selectedAnswer { border-color:var(--violet); background:var(--violet-soft); }
.quiz-feedback.needs-review { color:var(--danger); background:color-mix(in srgb,var(--danger) 8%,transparent); }
.flashcard { min-height:110px; display:grid; place-items:center; padding:15px; color:var(--ink); background:var(--bg-soft); text-align:center; font-family:var(--display); font-size:15px; cursor:pointer; }
.flashcard-controls { display:flex; justify-content:space-between; gap:8px; margin-top:10px; }
.learning-daily-stamp { color:var(--subtle); font-size:8px; }

/* Reduced motion, responsive and shared animation */
@keyframes spin { to { transform:rotate(360deg); } }
@keyframes hero-arrive { from { opacity:.65; transform:scale(1.045); } to { opacity:1; transform:scale(1.015); } }
@keyframes voice-pulse { from { box-shadow:0 0 0 0 color-mix(in srgb,var(--danger) 0%,transparent); } to { box-shadow:0 0 0 3px color-mix(in srgb,var(--danger) 14%,transparent); } }
